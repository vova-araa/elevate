# ── Publiek (veilig om te committen; VITE_* wordt in de client gebundeld) ──
SUPABASE_PROJECT_ID="jouw-project-id"
SUPABASE_URL="https://jouw-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="jouw-anon-key"
VITE_SUPABASE_PROJECT_ID="jouw-project-id"
VITE_SUPABASE_URL="https://jouw-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="jouw-anon-key"

# Plausible analytics (cookieloos — geen cookiebanner nodig). Zonder deze
# variabele laadt het script niet, dus geen nulmeting voordat het domein
# bekend is. Alleen de marketingsite; /admin en /client tellen niet mee.
# VITE_PLAUSIBLE_DOMAIN="elevatedesign.nl"

# Feature-flag: paid ads-overzicht op /admin/analytics (Meta/Google/TikTok
# Ads). Staat nog niet op een echte API-koppeling — laat deze uit tot dat er
# is, anders belooft het scherm live spend/CTR/ROAS die het niet levert.
# VITE_FEATURE_PAID_ADS="true"

# ── Server-side secrets (NOOIT committen — zet deze op je host/deploy-omgeving) ──
# Supabase service-role key (admin-operaties op de server)
SUPABASE_SERVICE_ROLE_KEY=""

# Claude API voor alle AI-features (captions, planner, AI Studio, assistent)
ANTHROPIC_API_KEY=""
# Optioneel: ander Claude-model (default: claude-opus-4-8)
# CLAUDE_MODEL="claude-opus-4-8"

# Optioneel: publieke basis-URL (zonder deze variabele wordt het draaiende domein gebruikt).
# De OAuth redirect-URI is altijd ${APP_URL}/api/public/oauth/callback — zie docs/KOPPELINGEN.md
APP_URL="https://app.jouwdomein.nl"
# Optioneel: geheim voor het ondertekenen van de OAuth state-parameter
# OAUTH_STATE_SECRET=""

# Meta (Instagram/Facebook) developer-app
META_APP_ID=""
META_APP_SECRET=""

# TikTok developer-app
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# Welke TikTok-scopes we aanvragen. TikTok weigert de hele autorisatie zodra er
# één scope bij zit die nog niet is goedgekeurd, dus houd deze gelijk aan wat er
# in het TikTok-portaal is toegekend. Na de volledige app-audit:
#   video.publish → direct openbaar posten (nu alleen concept via video.upload)
#   video.list    → de echte TikTok-feed teruglezen op dashboard en planner
#   user.info.stats → volgersaantal
# TIKTOK_SCOPES="user.info.basic,user.info.stats,video.publish,video.upload,video.list"

# LinkedIn developer-app
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Google (YouTube — koppelen/statistieken; publiceren nog niet ondersteund).
# Dezelfde OAuth-app bedient ook de bureau-brede Drive-koppeling op
# /admin/drive — voeg daarvoor de scope drive.readonly toe aan deze app in
# Google Cloud Console en registreer ${APP_URL}/api/public/oauth/drive-callback
# als extra redirect-URI. Zie TODO-VOVA.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Drive-import: klant deelt een map op "iedereen met de link" en plakt de
# link; wij lezen de map uit en halen alles op in originele kwaliteit. Een gewone
# API-sleutel volstaat (Google Cloud → APIs & Services → Credentials → API key,
# met de Google Drive API aangezet). Beperk de sleutel tot de Drive API.
GOOGLE_DRIVE_API_KEY=""

# Automation tick endpoint (cron beveiliging)
CRON_SECRET=""

# Publieke site-URL (voor links in webhooks/redirects)
# SITE_URL="https://app.jouwdomein.nl"

# Notificatiemail bij een nieuwe lead vanaf /contact (via Resend — resend.com).
# Zonder deze twee wordt de aanvraag wel opgeslagen, maar krijg je geen mail.
RESEND_API_KEY=""
LEADS_NOTIFICATION_EMAIL=""
# Optioneel: afzender voor die mail (moet een geverifieerd domein bij Resend zijn)
# LEADS_NOTIFICATION_FROM="Elevate Design <noreply@elevatedesign.nl>"
